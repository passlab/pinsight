# CUDA trace config for test/cuda.
#
# SECTION FORM MATTERS: all domain keys — trace_mode, punit ranges, node-policy
# keys, AND per-event on/off — go in a single [CUDA.default] section.  A
# [CUDA(subdomain).default] section (e.g. [CUDA(malloc).default]) is silently
# IGNORED by the parser, so per-event settings written that way never take
# effect.  Same gotcha as HIP; see doc/user/trace_config_format.md and
# pinsight-eval/code-memory/trace_config_convention.md.
#
# Events not listed here keep the DSL default from src/trace_domain_CUDA.h.

[CUDA.default]
    trace_mode = TRACING
    CUDA.device = (0, 16)

    # Which ranks open the CUPTI activity collection (GPU-side timestamps).
    # off | on | anyone_per_node | leader_per_node | rotate_per_node:<ms>
    # Default is `off`; `on` here so `make test` / verify_trace.sh see the
    # cudaKernelActivity + cudaMemcpyActivity records they check for.
    # Gates ONLY activity collection — host-side CUDA tracing is never gated.
    device_activity = on

    # --- contextdevice ---
    CUDA_context_create = off
    CUDA_context_destroy = off
    CUDA_device_init = off
    CUDA_device_reset = off
    CUDA_device_synchronize = on

    # --- streamevent ---
    CUDA_stream_create = off
    CUDA_stream_destroy = off
    CUDA_stream_synchronize = on
    CUDA_event_create = off
    CUDA_event_record = off
    CUDA_event_synchronize = off
    CUDA_event_destroy = off

    # --- memcpy (each CB pair has a matching cudaMemcpyActivity record) ---
    CUDA_memcpy_HtoD = on
    CUDA_memcpy_DtoH = on
    CUDA_memcpy_DtoD = on
    CUDA_memcpy_HtoH = on
    CUDA_memcpy_async = on

    # --- malloc ---
    CUDA_memset = off
    CUDA_malloc = on
    CUDA_free = on
    CUDA_malloc_host = off
    CUDA_free_host = off
    CUDA_malloc_managed = off

    # --- kernel (CB records the call site; ACT records the GPU exec window) ---
    CUDA_kernel_launch = on
    CUDA_kernel_complete = off
    CUDA_kernel_enqueue = off

    # --- others (misc driver/runtime events; off by default) ---
    CUDA_api_enter = off
    CUDA_api_exit = off
    CUDA_driver_call = off
    CUDA_runtime_call = off
    CUDA_synchronize = off
    CUDA_context_push = off
    CUDA_context_pop = off
    CUDA_module_load = off
    CUDA_module_unload = off
    CUDA_function_load = off
    CUDA_graph_create = off
    CUDA_graph_launch = off
    CUDA_graph_destroy = off
    CUDA_unified_memory_migrate = off
    CUDA_unified_memory_prefetch = off
    CUDA_nvtx_range_push = off
    CUDA_nvtx_range_pop = off
    CUDA_nvtx_mark = off
