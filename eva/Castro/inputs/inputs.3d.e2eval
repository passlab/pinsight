# ------------------  INPUTS FOR E2 EVALUATION  -------------------
# Castro Sedov 3D — PInsight E2 overhead measurement
# 4×A100 GPUs, 4 MPI ranks (1 per GPU)
# Base grid: 128^3, 2 AMR levels (effective max 512^3 around shock)
# 200 steps only — sufficient for overhead measurement, ~30s baseline runtime
# I/O disabled so overhead = pure compute + instrumentation

max_step  = 200
stop_time = 0.01

# PROBLEM SIZE & GEOMETRY
geometry.is_periodic =  0    0    0
geometry.coord_sys   =  0             # 0 => cartesian
geometry.prob_lo     =  0    0    0
geometry.prob_hi     =  1    1    1
amr.n_cell           = 128  128  128  # 128^3 base (vs default 32^3)

# BC FLAGS: 2 = Outflow
castro.lo_bc         =  2   2   2
castro.hi_bc         =  2   2   2

# PHYSICS
castro.do_hydro = 1
castro.do_react = 0
castro.ppm_type = 1

# TIME STEP CONTROL
castro.cfl            = 0.5
castro.init_shrink    = 0.01
castro.change_max     = 1.1

# AMR: 2 levels gives 128 -> 256 -> 512 effective resolution
amr.max_level       = 2
amr.ref_ratio       = 2 2
amr.regrid_int      = 4        # regrid every 4 steps
amr.blocking_factor = 32       # larger blocks for GPU efficiency
amr.max_grid_size   = 64       # tile size per GPU work unit

# Refinement criteria (same physics as reference)
amr.refinement_indicators = denerr dengrad presserr pressgrad
amr.refine.denerr.max_level     = 2
amr.refine.denerr.value_greater = 3
amr.refine.denerr.field_name    = density
amr.refine.dengrad.max_level    = 2
amr.refine.dengrad.gradient     = 0.01
amr.refine.dengrad.field_name   = density
amr.refine.presserr.max_level   = 2
amr.refine.presserr.value_greater = 3
amr.refine.presserr.field_name  = pressure
amr.refine.pressgrad.max_level  = 2
amr.refine.pressgrad.gradient   = 0.01
amr.refine.pressgrad.field_name = pressure

# DIAGNOSTICS — verbosity only, no file I/O (isolate compute overhead)
amr.v               = 1
castro.v            = 0
amr.check_int       = -1       # disable checkpoints
amr.plot_int        = -1       # disable plotfiles

# OUTPUT: just timing summary at end
amr.derive_plot_vars = NONE
