# ------------------  INPUTS FOR E5 EVALUATION  -------------------
# Castro Sedov 3D — PInsight E5 OpenMP+MPI overhead measurement
# CPU-only (OpenMP + MPI), no CUDA
# Base grid: 128^3, 1 AMR level (effective max 256^3 around shock)
# 30 steps — ~30s baseline at 24 total cores
# I/O disabled so overhead = pure compute + instrumentation

max_step  = 30
stop_time = 0.01

# PROBLEM SIZE & GEOMETRY
geometry.is_periodic =  0    0    0
geometry.coord_sys   =  0             # 0 => cartesian
geometry.prob_lo     =  0    0    0
geometry.prob_hi     =  1    1    1
amr.n_cell           = 128  128  128  # 128^3 base

# BC FLAGS: 2 = Outflow
castro.lo_bc         =  2   2   2
castro.hi_bc         =  2   2   2

# PHYSICS
castro.do_hydro = 1
castro.do_react = 0
castro.ppm_type = 1

# TIME STEP CONTROL
castro.cfl            = 0.5
castro.init_shrink    = 0.01
castro.change_max     = 1.1

# AMR: 1 level gives 128 -> 256 effective resolution
amr.max_level       = 1
amr.ref_ratio       = 2
amr.regrid_int      = 4        # regrid every 4 steps
amr.blocking_factor = 16
amr.max_grid_size   = 32

# Refinement criteria
amr.refinement_indicators = denerr dengrad presserr pressgrad
amr.refine.denerr.max_level     = 1
amr.refine.denerr.value_greater = 3
amr.refine.denerr.field_name    = density
amr.refine.dengrad.max_level    = 1
amr.refine.dengrad.gradient     = 0.01
amr.refine.dengrad.field_name   = density
amr.refine.presserr.max_level   = 1
amr.refine.presserr.value_greater = 3
amr.refine.presserr.field_name  = pressure
amr.refine.pressgrad.max_level  = 1
amr.refine.pressgrad.gradient   = 0.01
amr.refine.pressgrad.field_name = pressure

# DIAGNOSTICS — verbosity only, no file I/O
amr.v               = 1
castro.v            = 0
amr.check_int       = -1       # disable checkpoints
amr.plot_int        = -1       # disable plotfiles

# OUTPUT: just timing summary at end
amr.derive_plot_vars = NONE
